{
    "name": "distributed_high_sr_lundtem",
    "phase": "train", // train or val
    "gpu_ids": [
        0,1
    ],
    "path": { //set the path
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        // "resume_state": null
        "resume_state": "I640000_E37" //pretrain model or training state
    },
    "datasets": {
        "train": {
            "name": "LundTEM",
            "mode": "HR", // whether need LR img
            "dataroot": "dataset/lundtem_16_128",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 16, // low resolution need to super_resolution
            "r_resolution": 128, // high resolution
            "batch_size": 16, // 16 seems fastest for T4, 64 for A100
            "num_workers": 2, // 2 is recommended for T4, 12 for A100
            "use_shuffle": true,
            "data_len": -1 // -1 represents all data used in train
        },
        "val": {
            "name": "LundTEM",
            "mode": "LRHR",
            "dataroot": "dataset/lundtem_16_128_val",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 16,
            "r_resolution": 128,
            "data_len": 50
        }
    },
    "model": {
        "which_model_G": "sr3", // use the ddpm or sr3 network structure
        "loss_type": "l1", // l1 or l2 or gloss
        "finetune_norm": false,
        "ddim_sampling": true,    // Enable/disable DDIM
        "ddim_timesteps": 200,   // Number of steps for DDIM
        "unet": {
            "in_channel": 6,
            "out_channel": 3,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                8
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0.2
        },
        "beta_schedule": { // use manual beta_schedule for acceleration
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 128,
            "channels": 3, //sample channel
            "conditional": true // unconditional generation or conditional generation(super_resolution)
        }
    },
    "train": {
        "n_iter": 1e7,
        "val_freq": 1e3,
        "save_checkpoint_freq": 1e3,
        "print_freq": 500,
        "optimizer": {
            "type": "adam",
            "lr": 3e-6
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "distributed_high_sr_lundtem"
    }
}